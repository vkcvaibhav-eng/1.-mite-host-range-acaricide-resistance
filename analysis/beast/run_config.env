# Settings read by analysis/beast/gcloud_startup.sh every time the machine starts.
# To lengthen the chains, raise CHAIN_LENGTH here, push, and start the machine again: the chains resume.
ANALYSIS=tetranychoidea
# total number of states per chain
CHAIN_LENGTH=100000000
LOG_EVERY=10000
SEEDS="2026 2027 2028 2029"
THREADS_PER_CHAIN=2
BURNIN_PERCENT=10
BEAST_URL=https://github.com/CompEvol/beast2/releases/download/v2.7.7/BEAST.v2.7.7.Linux.x86.tgz
BEAST_SHA256=a866f3e5da4ef890a042f01849e32322aa0a8e16e3e1cb2c59f823de2611781a
# yes: the machine switches itself off when all chains have finished (no further machine charge)
SHUTDOWN_WHEN_DONE=yes
